rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public collections for store and website visitors
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null || true;
      
      match /reviews/{reviewId} {
        allow read, write: if true;
      }
    }
    
    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }
    
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    match /houses/{houseId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    match /rental_categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /rental_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Admin users management & system metadata
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /system_metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

