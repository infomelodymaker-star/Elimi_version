rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to products collection for real-time shop syncing
    match /products/{productId} {
      allow read, write: if true;
      
      match /reviews/{reviewId} {
        allow read, write: if true;
      }
    }
    
    // Newsletter subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }
    
    // Boutique orders
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Mobility and chauffeur fleet cars
    match /cars/{carId} {
      allow read, write: if true;
    }
    
    // Luxury real estate houses
    match /houses/{houseId} {
      allow read, write: if true;
    }
    
    // Other allocations and rental items
    match /rental_categories/{categoryId} {
      allow read, write: if true;
    }

    match /rental_items/{itemId} {
      allow read, write: if true;
    }

    // Registered users management and auth quota
    match /users/{userId} {
      allow read, write: if true;
    }

    match /system_metadata/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
